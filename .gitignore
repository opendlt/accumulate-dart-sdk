# Dart / Flutter build + tooling
.dart_tool/
.packages
pubspec.lock
# Anchored to the repo root ON PURPOSE. An unanchored `build/` also matches
# lib/src/build/ — the SDK's own source directory — which silently excluded
# builders.dart, context.dart and tx_types.dart from git and therefore from the
# published archive. The result: `import 'package:opendlt_accumulate/
# opendlt_accumulate.dart'` did not compile for any consumer of 2.2.0, because
# the umbrella library re-exports files that were not shipped.
/build/
!lib/src/build/
coverage/

# Generated API documentation (use `dart doc` to regenerate)
doc/api/

# Temporary documentation (audit reports, etc.)
doc/temp_docs/

# Local settings
.claude/

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Windows-reserved artifact that breaks Git indexing
nul

# Backup files
*.bak
*_backup.dart
*.orig

# Test artifacts
test_output/
*.log

# Temporary files
temp_*.json
*.tmp

# Secrets (should never be committed)
*.env
.env.*
credentials.json
secrets.json